views:
  - type: table
    name: Table
    filters:
      and:
        - type == "spec"
        - spec_number > 0
    order:
      - file.name
      - spec_number
      - status
      - doc_type
      - tags
      - created
      - updated
    sort: []
    columnSize:
      file.name: 372
      note.spec_number: 80
      note.status: 100
      note.doc_type: 80
      note.tags: 240
      note.created: 140
      note.updated: 140
