views:
  - type: table
    name: Table
    filters:
      and:
        - type == "spec"
        - spec_number > 0
    order:
      - file.name
      - spec_number
      - status
      - doc_type
      - tags
      - created
      - updated
    sort:
      - property: file.name
        direction: ASC
      - property: doc_type
        direction: DESC
    columnSize:
      file.name: 372
      note.spec_number: 80
      note.status: 100
      note.doc_type: 111
      note.tags: 240
      note.created: 140
      note.updated: 140
